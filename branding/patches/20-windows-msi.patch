+if exist \"{startup_dir}\\{legacy_name}\" del /f /q \"{startup_dir}\\{legacy_name}\"
+reg add HKEY_CLASSES_ROOT\\{subkey} /f /v {REG_NAME_INSTALL_STARTUPSHORTCUTS} /t REG_SZ /d \"0\" || exit /b 1
